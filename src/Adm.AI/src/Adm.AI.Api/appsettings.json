{
  "OpenAi": {
    "ApiKey": "",
    "Model": "gpt-4o",
    "MaxTokens": 4096,
    "Temperature": 0.0,
    "TimeoutSeconds": 120,
    "MaxRetries": 2,
    "InputTokenPricePerMillion": 2.5,
    "OutputTokenPricePerMillion": 10.0
  },
  "FileUpload": {
    "MaxFileSizeBytes": 26214400,
    "MaxExtractedTextLength": 500000,
    "AllowedExtensions": [
      ".pdf"
    ],
    "AllowedContentTypes": [
      "application/pdf"
    ]
  },
  "Prompts": {
    "BasePath": "prompts"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=adm_ai;Username=postgres;Password="
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/adm-ai-.log",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "AllowedHosts": "*",
  "AiProcessing": {
    "MaxConcurrentRequests": 3,
    "MaxBatchSize": 10
  },
  "SdsChunking": {
    "Enabled": true,
    "Groups": [
      {
        "Name": "group_1_4",
        "Sections": [
          1,
          2,
          3,
          4
        ]
      },
      {
        "Name": "group_5_8",
        "Sections": [
          5,
          6,
          7,
          8
        ]
      },
      {
        "Name": "group_9_12",
        "Sections": [
          9,
          10,
          11,
          12
        ]
      },
      {
        "Name": "group_13_16",
        "Sections": [
          13,
          14,
          15,
          16
        ]
      }
    ]
  }
}