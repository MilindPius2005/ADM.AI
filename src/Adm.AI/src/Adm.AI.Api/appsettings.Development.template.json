{
  "OpenAi": {
    "ApiKey": "YOUR_API_KEY_HERE",
    "Model": "gemini-3.6-flash",
    "EndpointUrl": "https://generativelanguage.googleapis.com/v1beta/openai/",
    "MaxTokens": 16384,
    "Temperature": 0.0,
    "TimeoutSeconds": 600,
    "MaxRetries": 6,
    "InputTokenPricePerMillion": 2.5,
    "OutputTokenPricePerMillion": 10.0
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=adm_ai_dev;Username=postgres;Password=postgres"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug"
    }
  },
  "Prompts": {
    "BasePath": "../../prompts"
  },
  "AiProcessing": {
    "MaxConcurrentRequests": 3,
    "MaxBatchSize": 10
  },
  "SdsChunking": {
    "Enabled": true,
    "Groups": [
      {
        "Name": "group_1_4",
        "Sections": [1, 2, 3, 4]
      },
      {
        "Name": "group_5_8",
        "Sections": [5, 6, 7, 8]
      },
      {
        "Name": "group_9_12",
        "Sections": [9, 10, 11, 12]
      },
      {
        "Name": "group_13_16",
        "Sections": [13, 14, 15, 16]
      }
    ]
  }
}
