# ====================================================================
# .gitignore for Adm.AI / Tanality SDS Analyzer (.NET 8, Web, macOS)
# ====================================================================

# --------------------------------------------------------------------
# 1. .NET / C# Build Outputs & Compilation Artifacts
# --------------------------------------------------------------------
[Bb]in/
[Oo]bj/
[Oo]ut/
[Bb]uild/
*.dll
*.pdb
*.exe
*.so
*.dylib
*.cache
*.user
*.userosscache
*.suo
*.sln.docstates
*.userprefs
*.pidb
*.booproj

# MSBuild & NuGet Artifacts
project.lock.json
project.assets.json
*.nuget.props
*.nuget.targets
packages/
!**/packages/build/

# Test Results, Code Coverage & Profiler outputs
[Tt]est[Rr]esults/
*.trx
*.coverage
*.coveragexml
*.cobertura.xml
_ReSharper*/

# --------------------------------------------------------------------
# 2. Sensitive Configurations, Environment Files & Secrets
# --------------------------------------------------------------------
# Exclude local/development configs that may contain API keys or passwords
appsettings*.Development.json
appsettings*.Production.json
appsettings*.Local.json
appsettings*.override.json
secrets.json
.env
.env.*
*.local

# Whitelist safe configuration templates
!appsettings.json
!appsettings*.template.json
!appsettings*.example.json

# --------------------------------------------------------------------
# 3. Logs & Diagnostic Outputs
# --------------------------------------------------------------------
*.log
logs/
**/logs/
**/log/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --------------------------------------------------------------------
# 4. IDE, Code Editor & Workspace Settings
# --------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.DotSettings.user
*.swp
*.swo
*~
*.bak

# --------------------------------------------------------------------
# 5. Operating System Specific Files
# --------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# Linux
*~

# --------------------------------------------------------------------
# 6. Python Artifacts & Virtual Environments (if applicable)
# --------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
venv/
.venv/
env/

# --------------------------------------------------------------------
# 7. Temporary, Scratch & Cleanup Files
# --------------------------------------------------------------------
*.tmp
*.temp
backup_*
fix_*.cs
_cleanup_candidates/

# --------------------------------------------------------------------
# 8. Local / Sample Binary Documents (PDFs)
# --------------------------------------------------------------------
# Exclude sample SDS PDFs from bloating git repository history
*.pdf
